{
  "name": "unreal-rc-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter unreal-rc build",
    "typecheck": "pnpm --filter unreal-rc typecheck",
    "test": "pnpm --filter unreal-rc test",
    "test:e2e": "node scripts/test-unreal-e2e.ts",
    "test:all": "pnpm test && pnpm test:e2e",
    "clean": "pnpm --filter unreal-rc clean",
    "pack:core": "pnpm --filter unreal-rc pack:check",
    "publish": "pnpm pack:core && pnpm --filter unreal-rc publish",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "fixture:init": "node scripts/unreal-fixture.ts init",
    "fixture:status": "node scripts/unreal-fixture.ts status",
    "fixture:update": "node scripts/unreal-fixture.ts update",
    "prepare": "effect-tsgo patch"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.24.2",
    "@types/node": "^25.5.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.15.1"
}
